{
  "window.newWindowDimensions": "maximized",

  "editor.bracketPairColorization.enabled": false,
  "editor.detectIndentation": false,
  "editor.fontFamily": "Fira Mono, SF Mono, Consolas, Segoe UI, monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 16,
  "editor.hover.delay": 250,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderWhitespace": "none",
  "editor.stickyScroll.maxLineCount": 3,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.wordWrap": "on",
  
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": true,
  "explorer.sortOrder": "filesFirst",

  "workbench.colorTheme": "Tomorrow Night Blue",
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": false,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",

  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.stickyScroll.enabled": false,

  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,
  "remoteHub.commitDirectlyWarning": "off",
  "redhat.telemetry.enabled": false,
  
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.associations": {
    "*.uss": "css"
  },

  // git
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "never",
  "scm.showOutgoingChanges": "always",
  "scm.showIncomingChanges": "always",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  // Markdown
  "markdown.preview.fontSize": 16,

  // Python
  "[python]": {
    "editor.formatOnType": true
  },

  "python.terminal.executeInFileDir": true,
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "workbench.startupEditor": "none",

  // C#
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.semanticHighlighting.enabled": false,
    "editor.formatOnType": false,
    "dotnet.codeLens.enableReferencesCodeLens": false,
  },

  // Svelte
  "svelte.enable-ts-plugin": true,

  // Ruby
  "rubyLsp.rubyExecutablePath": "c:\\Ruby33-x64\\bin\\ruby.exe",

  // Unity
  "[UnityUXML]": {
    "editor.tabSize": 4,
  },
  "[UnityUSS]": {
    "editor.tabSize": 4,
  },

  // Haskell
  "haskell.manageHLS": "GHCup",

  // Rust
  "[rust]": {
    "editor.tabSize": 4,
  },

  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.separate.macro.bang": true,
  "rust-analyzer.semanticHighlighting.operator.enable": false,

  "workbench.colorCustomizations": {
    "[Tomorrow Night Blue]": {
      "editor.background": "#00172a",
      "editor.foreground": "#fff",
      "editorLineNumber.foreground": "#145090",
      "editorLineNumber.activeForeground": "#ffffff",
      // "editor.selectionBackground": "#",
      // "editor.inactiveSelectionBackground": "#",
      // "editor.selectionHighlightBackground": "#",
      "editor.lineHighlightBackground": "#002052",
      "editorIndentGuide.background1": "#003060",
      "editorIndentGuide.activeBackground1": "#2070c1",
      // "editor.foldBackground": "#002042",
      "editorWidget.resizeBorder": "#40e0ff",
      "editorWarning.foreground": "#ff0040",

      "titleBar.activeBackground": "#000020",
      "titleBar.inactiveBackground": "#000020",
      "menubar.selectionBackground": "#ff0090",
      "menubar.selectionForeground": "#ffffff",
      "statusBar.background": "#000020",
      "activityBar.background": "#000020",
    },
  },

  // SYNTAX HIGHLIGHTING
  "editor.tokenColorCustomizations": {
    "comments": "#70767c",
    "keywords": "#4090f1",
    "functions": "#ff0090",
    "types": "#9090f1",
    // "variables": "#fff",
    "strings": "#409090",
    "numbers": "#c0f0ff",

    "[Tomorrow Night Blue]": {
      "textMateRules": [
        /// General
        // {
        //   "scope": "support.other.variable",
        //   "settings": {"foreground": "#fff"}
        // }, {
        //   "scope": "constant.language",
        //   "settings": {"foreground": "#60c7c7", "fontStyle": "italic"}
