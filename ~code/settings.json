  "editor.semanticTokenColorCustomizations": {
    "[Tomorrow Night Blue]": {
      "rules": {
        /// Global
        "function": "#ff0090",
        "function.builtin": "#40e0ff",
        "interface": "#c7c7ff",
        "enum": "#c1fff1",
        "*.typeHint": {"fontStyle": "italic"},

        /// Python
        "variable:python": "#fff",
        "builtinConstant:python": "#c7c7ff",

        /// JavaScript / TypeScript
        "variable:javascript": "#fff",
