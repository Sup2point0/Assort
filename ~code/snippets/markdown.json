{
  "squark": {
    "prefix": ["/squark"],
    "body": [
      "<!-- #SQUARK $1 -->"
    ]
  },
  "squark.section": {
    "prefix": ["/squark~section"],
    "body": [
      "<!-- #SQUARK $1? -->",
      "<!-- #SQUARK $1. -->",
    ]
  },
  "squark.charm": {
    "prefix": ["/squark~charm", "/sup~squark"],
    "body": [
      "<!-- #SQUARK live!",
      "| dest = $1",
      "| index = $2",
      "-->"
    ]
  },

  "latex.mathbb": {
    "prefix": ["/latex~mathbb"],
    "body": [
      "\\mathbb{$1}"
    ]
  },
  "latex.align": {
    "prefix": ["/latex~align"],
    "body": [
      "```math",
      "\\begin{align*}",
      "  $2",
      "  \\\\\\\\ ",
      "\\end{align*}",
      "```"
    ]
  },
  "latex.align.first": {
    "prefix": "/latex~align~first",
    "body": [
      "```math",
      "\\begin{align*}",
      "  &\\ $2",
      "  \\\\\\\\ =&\\ ",
      "\\end{align*}",
      "```"
    ]
  },
  "latex.parts": {
    "prefix": "/latex~parts",
    "body": [
      "```math",
      "\\begin{align*}",
      "      f &=  \\quad&\\quad g' &= ",
      "  \\ f' &=  \\quad&\\quad g &= ",
      "\\end{align*}",
      "```"
    ]
  },

  "desmos.function.definition": {
    "prefix": "/desmos~function",
    "body": [
      "## $1",
      "",
      "```math",
      "$2_\\text{$3} \\left(\\,",
      "  $4_\\text{$5}",
      "\\,\\right)",
      "```",
      "",
      "> $6",
      "",
      "### Arguments",
      "| Argument | Description | Domain | Constraints | Notes |",
      "| :------- | :---------- | :----- | :---------- | :---- |",
      "| $$4_\\text{$5}$ | $9 |",
      "",
      "### Return",
      "| Value | Description | Codomain | Constraints | Notes |",
      "| :---- | :---------- | :------- | :---------- | :---- |",
      "| $${10:\\omega}$ |",
      "",
      "### Instances",
      "```desmos",
      "",
      "```",
      "",
      "### Implementation",
      "```math",
      "$2_\\text{$3} \\left(\\,",
      "  $4_\\text{$5}",
      "\\,\\right)",
      "=",
      "$7",
      "```",
      "",
      "### Dependencies",
      "- $$8$",
    ]
  }
}
