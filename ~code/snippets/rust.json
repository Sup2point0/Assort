{
  "weighted-list impl": {
    "prefix": "/wl.impl",
    "body": [
      "impl<V, W: Weight> $1WeightedList<V,W>",
      "{$2}"
    ]
  },

  "print": {
    "prefix": "/print.debug",
    "body": [
      "println!(\"$1 = {:?}\", $1);"
    ]
  },

  "assert": {
    "description": "Unit Test Assertion",
    "prefix": "/test.assert",
    "body": [
      "assert!( $1 );"
    ]
  },
  "assert-eq": {
    "description": "Unit Test == Assertion",
    "prefix": "/test.assert-eq",
    "body": [
      "assert_eq!( $1 );"
    ]
  },
  "assert-ne": {
    "description": "Unit Test != Assertion",
    "prefix": "/test.assert-ne",
    "body": [
      "assert_ne!( $1 );"
    ]
  }
}
