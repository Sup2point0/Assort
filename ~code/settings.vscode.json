  "editor.semanticTokenColorCustomizations": {
    "[Tomorrow Night Blue]": {
      "rules": {
        /// Global [semantic]
        "function": "#ff0090",
        "function.builtin": "#40e0ff",
        "interface": "#c7c7ff",

        /// Python [semantic]
        "variable:python": "#fff",
        "builtinConstant:python": "#c7c7ff",

        /// JavaScript / TypeScript [semantic]
        "variable.defaultLibrary:javascript": "#40f190",
        "variable.defaultLibrary:typescript": "#40f190",

        "variable:javascript": "#fff",
        "variable:typescript": "#fff",
        "variable.other.readwrite:javascript": "#fff",
        "variable.other.readwrite:typescript": "#fff",

        "property:javascript": "#fff0c0",
        "property:typescript": "#fff0c0",
        "property:svelte": "#fff0c0",

        "typeParameter:javascript": "#40e0ff",
        "typeParameter:typescript": "#40e0ff",

        "enum:javascript": "#c7c7ff",
        "enum:typescript": "#c7c7ff",
        "enumMember:javascript": "#c1fff1",
        "enumMember:typescript": "#c1fff1",

        /// Svelte [semantic]
        "variable:svelte": "#fff",
        "variable.defaultLibrary:svelte": "#40f190",

        /// Ruby [semantic]
        "variable:ruby": "#fff",
        "variable.default_library:ruby": {"foreground": "#ffc7ff", "fontStyle": "italic"},

        /// Rust [semantic]
        "variable:rust": "#fff",
        "keyword:rust": "#4090f1",
        "struct:rust": "#9090f1",
        "operator:rust": "#ff9020",
        "typeParameter:rust": "#40e0ff",
        "comment.documentation:rust": "#60c7c7",
        
        "enumMember:rust": "#c1fff1",
        "boolean:rust": {"foreground": "#c1fff1", "fontStyle": "italic"},
        "selfKeyword:rust": {"foreground": "#ffc7ff", "fontStyle": "italic"},
        "selfTypeKeyword:rust": "#40e0ff",
        "label:rust": "#ffc720",

        "lifetime:rust": "#ff00f1",
        "macro:rust": "#00ffc7",
        "macroBang:rust": "#00ffc7",
        "macro.declaration:rust": "#00ffc7",
        "decorator.attribute:rust": "#00ffc7",
        "attributeBracket:rust": "#9040f1",
        "method.attribute.procMacro:rust": "#f190f1",
      }
    }
  },

