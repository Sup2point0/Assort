{
  "files.insertFinalNewline": true,
  "editor.wordWrap": "on",

  "window.newWindowDimensions": "maximized",

  "editor.bracketPairColorization.enabled": false,
  "editor.detectIndentation": false,
  "editor.fontFamily": "Fira Mono, SF Mono, Consolas, Segoe UI, monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 16,
  "editor.hover.delay": 250,
  "editor.insertSpaces": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderWhitespace": "none",
  "editor.stickyScroll.maxLineCount": 3,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": true,
  "explorer.sortOrder": "filesFirst",

  "workbench.colorTheme": "Tomorrow Night Blue",
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": false,
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",

  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.stickyScroll.enabled": false,

  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,
  "remoteHub.commitDirectlyWarning": "off",
  "redhat.telemetry.enabled": false,
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.associations": {
    "*.uss": "css"
  },

  /// git
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "never",
  "scm.showOutgoingChanges": "always",
  "scm.showIncomingChanges": "always",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  /// Markdown
  "markdown.preview.fontSize": 16,

  /// Python
  "[python]": {
    "editor.formatOnType": true,
    "editor.tabSize": 4
  },

  "python.terminal.executeInFileDir": true,
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "workbench.startupEditor": "none",

  /// C#
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.semanticHighlighting.enabled": false,
    "editor.formatOnType": false,
    "dotnet.codeLens.enableReferencesCodeLens": false,
  },

  /// Svelte
  "svelte.enable-ts-plugin": true,

  /// Ruby
  // "rubyLsp.rubyExecutablePath": "c:\\Ruby33-x64\\bin\\ruby.exe",

  /// Unity
  "[UnityUXML]": {
    "editor.tabSize": 4,
  },
  "[UnityUSS]": {
    "editor.tabSize": 4,
  },

  /// Haskell
  "haskell.manageHLS": "GHCup",

  /// Rust
  "[rust]": {
    "editor.tabSize": 4,
  },

  /// Kotlin
  "[kotlin]": {
    "editor.tabSize": 4
  },
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.separate.macro.bang": true,
  "rust-analyzer.semanticHighlighting.operator.enable": false,

  "workbench.colorCustomizations": {
    "[Tomorrow Night Blue]": {
      "editor.background": "#00172a",
      "editor.foreground": "#fff",
      "editorLineNumber.foreground": "#145090",
      "editorLineNumber.activeForeground": "#ffffff",
      // "editor.selectionBackground": "#",
      // "editor.inactiveSelectionBackground": "#",
      // "editor.selectionHighlightBackground": "#",
      "editor.lineHighlightBackground": "#002052",
      "editorIndentGuide.background1": "#003060",
      "editorIndentGuide.activeBackground1": "#2070c1",
      // "editor.foldBackground": "#002042",
      "editorWidget.resizeBorder": "#40e0ff",
      "editorWarning.foreground": "#ff0040",

      "titleBar.activeBackground": "#000020",
      "titleBar.inactiveBackground": "#000020",
      "menubar.selectionBackground": "#ff0090",
      "menubar.selectionForeground": "#fff",
      "statusBar.background": "#000020",
      "activityBar.background": "#000020",
    },
  },

  // SYNTAX HIGHLIGHTING
  "editor.tokenColorCustomizations": {
    "comments": "#70767c",
    "keywords": "#4090f1",
    "functions": "#ff0090",
    "types": "#9090f1",
    "strings": "#ffc0a9",
    "numbers": "#c0f0ff",

    "[Tomorrow Night Blue]": {
      "textMateRules": [

        /// TEST
        {
          "scope": "keyword",
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": "keyword.operator",
          "settings": {"foreground": "#ff9020"}
        },
        
        /// Markdown
        {
          "scope": "heading",
          "settings": {"foreground": "#40f190", "fontStyle": ""}
        }, {
          "scope": "entity.name.section.markdown",
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "markup.heading.setext.1.markdown, markup.heading.setext.2.markdown",
          "settings": {"foreground": "#40f190", "fontStyle": ""}
        }, {
          "scope": "markup.italic.markdown",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "markup.bold.markdown",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "string.other.link.title.markdown",
          "settings": {"foreground": "#40e0ff"}
        }, {
          "scope": "markup.underline.link.markdown",
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": "markup.inline.raw",
          "settings": {"foreground": "#9090f1"}
        }, {
          "scope": "markup.fenced_code.block.markdown",
          "settings": {"foreground": "#c7c7ff"}
        }, {
          "scope": "fenced_code.block.language.markdown",
          "settings": {"foreground": "#9090f1"}
        }, {
          "scope": "meta.embedded.math.markdown",
          "settings": {"foreground": "#60c7c7"}
        }, {
          "scope": "punctuation.definition.math",
          "settings": {"foreground": "#ffc720"}
        }, {
          "scope": "markup.list",
          "settings": {"foreground": "#c0f0ff"}
        }, {
          "scope": "markup.quote.markdown",
          "settings": {"foreground": "#c0f0ff"}
        }, {
          "scope": "meta.separator.markdown",
          "settings": {"foreground": "#ff0090"}
        }, {
          "scope": "constant.character.math.tex",
          "settings": {"foreground": "#ff9020"}
        }, {
          "scope": "string.other.link.description.markdown",
          "settings": {"foreground": "#40e0ff"}
        }, {
          "scope": "markup.underline.link.image.markdown",
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": "string.other.link",
          "settings": {"foreground": "#c7c7ff"}
        },
        // tables
        {
          "scope": "punctuation.definition.table.markdown",
          "settings": {"foreground": "#ff0090"}
        }, {
          "scope": "punctuation.separator.table.markdown",
          "settings": {"foreground": "#145090"}
        },
        
        {
          "scope": "constant.character.escape.markdown",
          "settings": {"foreground": "#409090"}
        },

        /// Python
        {
          "scope": "entity.name.type.class",
          "settings": {"foreground": "#9090f1"}
        }, {
          "scope": "entity.name.namespace",
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": [
            "keyword.operator.python",
            "keyword.operator.assignment.python",
            "keyword.operator.comparison.python",
            "keyword.operator.logical.python",
            "keyword.operator.bitwise.python",
            "keyword.operator.unpacking.parameter.python",
            "keyword.operator.unpacking.arguments.python",
          ],
          "settings": {"foreground": "#ff9020"}
        }, {
          "scope": "variable.parameter",
          "settings": {"foreground": "#f190f1"}
        }, {
          "scope": "meta.attribute.python",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "variable.other.property",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "constant.language.python",
          "settings": {"foreground": "#c7c7ff", "fontStyle": "italic"}
        }, {
          "scope": "entity.other.inherited-class.python",
          "settings": {"foreground": "#9090f1"}
        },
        // functions
        {
          "scope": "meta.function-call.generic",
          "settings": {"foreground": "#ff0090"}
        }, {
          "scope": "punctuation.definition.arguments.begin.python, punctuation.definition.arguments.end.python",
          "settings": {"foreground": "#ffffff"}
        }, {
          "scope": "variable.parameter.function-call.python",
          "settings": {"foreground": "#ffffff"}
        }, {
          "scope": "meta.function-call.arguments.python",
          "settings": {"foreground": "#ffffff"}
        },
        // punctuation
        {
          "scope": "punctuation.separator.python",
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": "punctuation.separator.colon.python",
          "settings": {"foreground": "#145090"}
        }, {
          "scope": "punctuation.separator.annotation.result",
          "settings": {"foreground": "#c1fff1"}
        }, {
          "scope": "constant.character.format.placeholder.other.python",
          "settings": {"foreground": "#9040f1"}
        }, {
          "scope": "constant.character.escape.python",
          "settings": {"foreground": "#60c7c7"}
        }, {
          "scope": "constant.other.ellipsis.python",
          "settings": {"foreground": "#c7c7ff"}
        }, {
          "scope": "punctuation.section.function.begin.python",
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": "string.quoted.docstring.multi.python",
          "settings": {"foreground": "#60c7c7"}
        },
        // misc
        {
          "scope": "invalid",
          "settings": {"foreground": "#ff0040"}
        }, {
          "scope": "keyword.codetag.notation.python",
          "settings": {"foreground": "#ffc720"}
        },

        /// C#
        {
          "scope": [
            "entity.name.type.namespace.cs",
          ],
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "comment.block.documentation.cs",
          "settings": {"foreground": "#409090"}
        },
        // variables
        {
          "scope": [
            "variable.other.readwrite.cs",
            "variable.other.object.cs",
            "variable.other.value.cs",
          ],
          "settings": {"foreground": "#fff"}
        }, {
          "scope": "entity.name.variable.parameter.cs",
          "settings": {"foreground": "#f190f1"}
        }, {
          "scope": [
            "entity.name.variable.property.cs",
            "variable.other.object.property.cs",
            "entity.name.variable.field.cs",
          ],
          "settings": {"foreground": "#fff0c0"}
        },
        // types
        {
          "scope": [
            "keyword.type.int.cs",
            "keyword.type.double.cs",
            "keyword.type.bool.cs",
            "keyword.type.string.cs",
            "keyword.type.uint.cs",
          ],
          "settings": {"foreground": "#9090f1"}
        }, {
          "scope": [
            "entity.name.type.interface.cs",
            "keyword.type.object.cs",
          ],
          "settings": {"foreground": "#c7c7ff"}
        }, {
          "scope": "entity.name.type.type-parameter.cs",
          "settings": {"foreground": "#40e0ff"}
        },
        // punctutation
        {
          "scope": "punctuation.terminator.statement.cs",
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": [
            "keyword.operator.assignment.cs",
            "keyword.operator.assignment.compound.cs",
            "keyword.operator.comparison.cs",
            "keyword.operator.relational.cs",
            "keyword.operator.logical.cs",
            "keyword.operator.conditional.question-mark.cs",
            "keyword.operator.conditional.colon.cs",
            "keyword.operator.increment.cs",
            "keyword.operator.decrement.cs",
            "punctuation.definition.typeparameters.begin.cs",
            "punctuation.definition.typeparameters.end.cs",
          ],
          "settings": {"foreground": "#ff9020"}
        }, {
          "scope": [
            "punctuation.separator.question-mark.cs",
            "keyword.operator.arrow.cs",
          ],
          "settings": {"foreground": "#ffc720"}
        }, {
          "scope": [
            "punctuation.accessor.cs",
            "punctuation.separator.comma.cs",
            "punctuation.separator.colon.cs",
          ],
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": [
            "punctuation.separator.coloncolon.cs",
            "variable.language.discard.cs",
          ],
          "settings": {"foreground": "#2070c1"}
        }, {
          "scope": [
            "punctuation.curlybrace.open.cs",
            "punctuation.curlybrace.close.cs",
          ],
          "settings": {"foreground": "#145090"}
        },
        // preprocess
        {
          "scope": [
            "meta.preprocessor.cs",
            "keyword.preprocessor.disable",
            "keyword.preprocessor.restore",
            "keyword.preprocessor.if.cs",
            "keyword.preprocessor.endif.cs",
          ],
          "settings": {"foreground": "#ff00f1"}
        }, {
          "scope": "string.unquoted.preprocessor.message.cs",
          "settings": {"foreground": "#ffc720"}
        }, {
          "scope": [
            "keyword.preprocessor.region.cs",
            "keyword.preprocessor.endregion.cs",
            "keyword.preprocessor.pragma.cs",
            "keyword.preprocessor.warning.cs",
            "punctuation.separator.hash.cs",
          ],
          "settings": {
            "foreground": "#145090"
          }
        }, {
          "scope": [
            "punctuation.definition.tag.cs",
            "entity.name.tag.localname.cs",
          ],
          "settings": {"foreground": "#60c7c7"}
        },
        // specific
        {
          "scope": [
            "keyword.operator.expression.new.cs",
            "variable.language.base.cs",
          ],
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "variable.language.this.cs",
          "settings": {"foreground": "#ffc7ff", "fontStyle": "italic"}
        }, {
          "scope": [
            "constant.language.boolean.true.cs",
            "constant.language.boolean.false.cs",
            "constant.language.null.cs",
          ],
          "settings": {"foreground": "#c1fff1", "fontStyle": "italic"}
        }, {
          "scope": [
            "keyword.other.directive.using.cs",
            "keyword.operator.expression.query.from.cs",
            "keyword.operator.expression.query.in.cs",
            "keyword.operator.expression.query.let.cs",
            "keyword.operator.expression.query.where.cs",
            "keyword.operator.expression.query.select.cs",
          ],
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": "keyword.operator.expression.pattern.is.cs",
          "settings": {"foreground": "#ff0090"}
        },
        
        /// HTML
        {
          "scope": "meta.tag",
          "settings": {"foreground": "#145090"}
        }, {
          "scope": "entity.name.tag",
          "settings": {"foreground": "#ff0090"}
        }, {
          "scope": "entity.other.attribute-name",
          "settings": {"foreground": "#f190f1"}
        }, {
          "scope": "punctuation.separator.key-value.html",
          "settings": {"foreground": "#ff9020"}
        }, {
          "scope": "string.unquoted.html",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "string.quoted.double.html",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "invalid.deprecated",
          "settings": {"foreground": "#f190f1"}
        }, {
          "scope": "constant.character.entity.named",
          "settings": {"foreground": "#c7c7ff"}
        },

        /// CSS
        {
          "scope": "entity.name.tag.css",
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "entity.other.attribute-name.class.css",
          "settings": {"foreground": "#9090f1"}
        }, {
          "scope": "entity.other.attribute-name.id.css",
          "settings": {"foreground": "#40e0ff"}
        }, {
          "scope": "entity.other.attribute-name.pseudo-class.css",
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": "entity.other.attribute-name.pseudo-element.css",
          "settings": {"foreground": "#c7c7ff"}
        }, {
          "scope": [
            "support.type.property-name.css",
            "meta.property-name.scss",
          ],
          "settings": {"foreground": "#f190f1"}
        }, {
          "scope": [
            "meta.property-value.css",
            "meta.property-value.scss",
          ],
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": "support.constant.property-value.css",
          "settings": {"foreground": "#fff0c0", "fontStyle": "italic"}
        }, {
          "scope": "constant.other.color.rgb-value.hex.css",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": [
            "support.constant.color.w3c-standard-color-name.css",
            "support.constant.color.w3c-extended-color-name.css",
          ],
          "settings": {"foreground": "#c7c7ff", "fontStyle": "italic"}
        }, {
          "scope": "keyword.other.unit",
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": [
            "punctuation.section.function.begin.bracket.round.css",
            "punctuation.section.function.end.bracket.round.css",
          ],
          "settings": {"foreground": "#fff"}
        }, {
          "scope": [
            "punctuation.definition.entity.css",
            "punctuation.separator.delimiter.scss",
          ],
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": "punctuation.terminator.rule.css",
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "support.constant.css",
          "settings": {"foreground": "#c7c7ff", "fontStyle": "italic"}
        }, {
          "scope": [
            "support.constant.media.css",
          ],
          "settings": {"foreground": "#ffc7ff", "fontStyle": "italic"}
        },

        /// SCSS [TO MERGE]
        {
          "scope": [
            "punctuation.terminator.rule.css",
            "punctuation.terminator.rule.scss",
          ],
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "variable.scss",
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": [
            "punctuation.section.function.scss",
          ],
          "settings": {"foreground": "#fff"}
        }, {
          "scope": [
            "punctuation.definition.interpolation.begin.bracket.curly.scss",
