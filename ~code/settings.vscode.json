          ],
          "settings": {"foreground": "#6040f1"}
        }, {
          "scope": [
            "meta.property-list.css",
            "meta.property-list.scss",
          ],
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": [
            "punctuation.section.property-list.begin.bracket.curly.css",
            "punctuation.section.property-list.begin.bracket.curly.scss",
            "punctuation.section.property-list.end.bracket.curly.css",
            "punctuation.section.property-list.end.bracket.curly.scss",
          ],
          "settings": {"foreground": "#145090"}
        }, {
          "scope": "entity.other.attribute-name.scss",
          "settings": {"foreground": "#ffc720"}
        }, {
          "scope": [
            "entity.name.tag.reference.scss",
          ],
          "settings": {"foreground": "#ffc720"}
        },

        /// JavaScript / TypeScript
        {
          "scope": [
            "variable.other.readwrite.js",
            "variable.other.readwrite.ts",
            "variable.other.readwrite.alias.js",
            "variable.other.readwrite.alias.ts",
            "variable.other.object.js",
            "variable.other.object.ts",
            "variable.other.constant.js",
            "variable.other.constant.ts",
          ],
          "settings": { "foreground": "#fff" }
        }, {
          "scope": [
            "variable.object.property.js",
            "variable.object.property.ts",
            "variable.other.object.property.js",
            "variable.other.object.property.ts",
            "variable.other.constant.property.js",
            "variable.other.constant.property.ts",
            "variable.other.constant.object.property.js",
            "variable.other.constant.object.property.ts",
            "support.variable.property.js",
            "support.variable.property.ts",
          ],
          "settings": {"foreground": "#fff0c0"}
        }, {
          "scope": [
            "keyword.operator.new.js",
            "keyword.operator.new.ts",
          ],
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": "variable.language.super.ts",
          "settings": {"foreground": "#ffc7ff", "fontStyle": "italic"}
        }, {
          "scope": [
            "constant.character.escape.ts",
            "string.regexp.ts",
          ],
          "settings": {"foreground": "#60c7c7"}
        },
        // punctuation
        {
          "scope": [
            "punctuation.terminator.statement.js",
            "punctuation.terminator.statement.ts",
            "constant.language.import-export-all.js",
            "constant.language.import-export-all.ts",
          ],
          "settings": {"foreground": "#40f190"}
        }, {
          "scope": [
            "punctuation.definition.template-expression.begin.ts",
            "punctuation.definition.template-expression.end.ts",
          ],
          "settings": {"foreground": "#6040f1"}
        }, {
          "scope": [
            "keyword.operator.assignment.ts",
            "keyword.operator.assignment.compound.ts",
            "keyword.operator.comparison.ts",
            "keyword.operator.relational.ts",
            "keyword.operator.logical.ts",
            "keyword.operator.ternary.ts",
            "keyword.operator.spread.ts",
            "keyword.operator.increment.ts",
            "keyword.operator.decrement.ts",
            "keyword.operator.type.ts",
            "punctuation.definition.typeparameters.begin.ts",
            "punctuation.definition.typeparameters.end.ts",
          ],
          "settings": {"foreground": "#ff9020"}
        }, {
          "scope": [
            "storage.type.function.arrow.ts",
            "keyword.operator.optional.ts",
            "punctuation.accessor.optional.ts",
            "keyword.operator.rest.ts",
            "keyword.operator.quantifier.regexp",
          ],
          "settings": {"foreground": "#ffc720"}
        }, {
          "scope": [
            "punctuation.accessor.js",
            "punctuation.accessor.ts",
            "punctuation.separator.comma.js",
            "punctuation.separator.comma.ts",
            "keyword.operator.type.annotation.js",
            "keyword.operator.type.annotation.ts",
            "punctuation.separator.key-value.js",
            "punctuation.separator.key-value.ts",
            "punctuation.definition.section.case-statement.js",
            "punctuation.definition.section.case-statement.ts",
          ],
          "settings": {"foreground": "#90969e"}
        }, {
          "scope": "punctuation.definition.block.ts",
          "settings": {"foreground": "#145090"}
        },
        // specific
        {
          "scope": [
            "keyword.operator.expression.of.js",
            "keyword.operator.expression.of.ts",
          ],
          "settings": {"foreground": "#4090f1"}
        }, {
          "scope": [
            "keyword.operator.expression.in.js",
            "keyword.operator.expression.in.ts",
            "keyword.operator.expression.typeof.js",
            "keyword.operator.expression.typeof.ts",
            "keyword.operator.expression.keyof.js",
            "keyword.operator.expression.keyof.ts",
          ],
          "settings": {"foreground": "#ff0090"}
        }, {
          "scope": [
            "constant.language.undefined.js",
            "constant.language.undefined.ts",
            "constant.language.null.js",
            "constant.language.null.ts",
            "constant.language.boolean.true.js",
            "constant.language.boolean.true.ts",
            "constant.language.boolean.false.js",
            "constant.language.boolean.false.ts",
          ],
          "settings": {"foreground": "#c1fff1", "fontStyle": "italic"}
        }, {
          "scope": "variable.language.this.ts",
          "settings": {"foreground": "#ffc7ff", "fontStyle": "italic"}
        },
        // JSDoc
        {
          "scope": "variable.other.jsdoc",
