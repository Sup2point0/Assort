{
  "type": "module",

  "name": "Assort",
  "version": "3.0",
  "private": true,

  "scripts":
  {
    "dev":      "vite dev",
      "devx":   "npm run prep && vite dev --open",
    
    "prep":     "squarkdown",
      "prepx":  "squarkdown --fonts --assets",

    "build":    "vite build",
      "buildx": "npm run prepx && vite build",

    "preview":  "vite preview",

    "test":     "playwright test",
      "testx":  "npm run buildx && playwright test"
  },

  "imports": {
    "#src/*":     "./src/*",
    "#parts/*":   "./src/parts/*/index.js",
    "#styles/*":  "./src/styles/*",
    "#scripts/*": "./src/scripts/*"
  },

  "dependencies":
  {
    "@sup2.0/weighted-list": "^0.2",
    "@stdlib/random-sample": "^0.2",
    "core-js": "^3.51",
    "fuzzball": "^2.2",
    "svelte-persisted-store": "^0.12"
  },

  "devDependencies":
  {
    "stranger-quarkdown": "^4.0",
    "@playwright/test": "^1.60",
    "@sveltejs/adapter-static": "^4.0",
    "@sveltejs/kit": "^3.0",
    "@sveltejs/vite-plugin-svelte": "^7.0",
    "@types/node": "^26.0",
    "mdsvex": "^0.12.8",
    "remark-footnotes": "^2.0.0",
    "rehype-katex-svelte": "^1.2.0",
    "remark-math": "^3.0.0",
    "remark-numbered-footnote-labels": "^1.1.0",
    "rehype-slug": "^6.0.0",
    "sass": "^1.100",
    "svelte": "^5.0",
    "svelte-preprocess": "^6.0",
    "typescript": "^6.0",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.0"
  }
}
